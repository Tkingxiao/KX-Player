{
  "name": "kx-music-player",
  "version": "2.0.0",
  "author": "Kingxiao",
  "description": "KX音乐播放器 - 本地 ASMR 音视频播放器（Tauri 2 + Rust 内核）",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:vite": "vite",
    "build": "vite build",
    "build:fe": "vite build",
    "tauri": "tauri",
    "check": "vue-tsc --noEmit && node scripts/gen-ipc-doc.mjs --check && node scripts/check-columns.mjs && vitest run && cd src-tauri && cargo clippy --all-targets -- -D warnings",
    "check:types": "vue-tsc --noEmit",
    "check:ffmpeg": "node scripts/check-ffmpeg.mjs",
    "check:ipc": "node scripts/gen-ipc-doc.mjs --check",
    "check:columns": "node scripts/check-columns.mjs",
    "check:clippy": "cd src-tauri && cargo clippy --all-targets -- -D warnings",
    "test": "vitest run && cd src-tauri && cargo test",
    "gen:ipc": "node scripts/gen-ipc-doc.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@vueuse/core": "^15.0.0",
    "chinese-conv": "^4.0.0",
    "pinia": "^4.0.3",
    "pinyin-pro": "^3.28.1",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.6.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "^8.1.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
